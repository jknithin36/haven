# Copy this file to .env and fill in your values.

# Public URL of the deployed site, without a trailing slash. Used for
# canonical links, Open Graph/Twitter cards, robots.txt, and sitemap.xml.
VITE_SITE_URL=https://haven.example.com

# Your API, once you connect a backend (see docs/BACKEND.md).
# VITE_API_URL=https://api.example.com
