{
  "name": "haven",
  "private": true,
  "version": "1.0.0",
  "description": "Haven: an open-source real-estate website and admin dashboard template built with React, TypeScript, Vite, and Tailwind CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jknithin36/haven.git"
  },
  "homepage": "https://github.com/jknithin36/haven#readme",
